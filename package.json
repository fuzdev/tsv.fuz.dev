{
  "name": "tsv.fuz.dev",
  "version": "0.0.1",
  "description": "website for tsv, precise language tools for TypeScript/JS, CSS, and Svelte in Rust",
  "glyph": "🪶",
  "logo": "logo.svg",
  "logo_alt": "a pixelated orange quill drawing a precise line",
  "license": "MIT",
  "homepage": "https://tsv.fuz.dev/",
  "repository": "https://github.com/fuzdev/tsv.fuz.dev",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "deploy": "gro deploy",
    "update-benchmarks": "cp ../tsv/benches/js/results/report.node.json src/routes/docs/benchmarks/benchmarks.json && cp ../tsv/benches/js/results/report.json src/routes/docs/benchmarks/benchmarks_cross_runtime.json && cp ../tsv/benches/js/results/report.conformance.node.json src/routes/docs/conformance/conformance.json"
  },
  "type": "module",
  "imports": {
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_code": "^0.52.1",
    "@fuzdev/fuz_css": "^0.66.2",
    "@fuzdev/fuz_ui": "^0.213.0",
    "@fuzdev/fuz_util": "^0.72.0",
    "@fuzdev/gro": "^0.216.0",
    "@fuzdev/mdz": "^0.4.0",
    "@fuzdev/tsv-wasm": "^0.6.0",
    "@ryanatkn/eslint-config": "^0.13.0",
    "@sveltejs/acorn-typescript": "^1.0.9",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.12.4",
    "@webref/css": "^8.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "esm-env": "^1.2.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.9.0",
    "svelte2tsx": "^0.7.61",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "zimmerframe": "^1.1.4",
    "zod": "^4.3.6"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ]
}
